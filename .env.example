# Valor del atributo content para verificar el dominio en Google Search Console.
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Dominio canónico de producción, sin barra final.
PUBLIC_SITE_URL=https://woki.com.pe

# Usa true en previews o en *.vercel.app antes de activar el dominio definitivo.
PUBLIC_NOINDEX=

# URL de la ficha de Woki en Google Play; déjalo vacío hasta que esté publicada.
PUBLIC_GOOGLE_PLAY_URL=

# Endpoint de recepción del formulario; déjalo vacío si aún no está configurado.
PUBLIC_CONTACT_FORM_ENDPOINT=
