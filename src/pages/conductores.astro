---
import { Picture } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { buildSectionJsonLd, driverBenefits, driverReasons } from '../data/content';
import { assets, brand } from '../data/site';

const title = `Conduce con Woki en ${brand.city}`;
const description = `Conduce taxi con Woki en Cerro de Pasco: revisa solicitudes, tarifas y actividad desde la app. Conoce los pasos para empezar.`;
const structuredData = buildSectionJsonLd(Astro.site, '/conductores', 'Conduce con Woki', description);
---
<Layout title={title} description={description} image={assets.driverPhoto} bannerImage={assets.driverPhoto} imageAlt="Conductor de taxi revisando sus viajes en la app de Woki" ogType="article">
  {structuredData.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} slot="head" />)}
  <Header solid />
  <main id="main-content">
    <section class="subpage-hero detail-hero"><div class="wrap"><p class="eyebrow">Para quienes conducen</p><h1>Conduce con Woki a tu manera</h1><p class="lead">Conoce las funciones que te ayudan a revisar cada solicitud y mantener a la vista la información de tus viajes.</p></div></section>
    <section class="detail-section driver-detail-intro driver-split" aria-labelledby="driver-detail-title">
      <div class="wrap detail-driver-grid">
        <div class="detail-driver-photo"><Picture src={assets.driverPhoto} formats={['avif', 'webp']} widths={[360, 540, 720, 960, 1200]} sizes="(min-width: 920px) 48vw, 100vw" alt="Conductor de taxi en Cerro de Pasco" loading="eager" fetchpriority="high" decoding="async" /></div>
        <div><p class="eyebrow dark">Tu trabajo, a tu manera</p><h2 id="driver-detail-title">Decide con información a la vista</h2><p class="lead">Antes de aceptar una solicitud, revisa los datos del recorrido y la forma de pago. Después puedes consultar tus ganancias y actividad desde la app.</p><a class="btn solid" href="/#descargar">Conoce Woki</a></div>
      </div>
    </section>
    <section class="detail-section driver-detail-benefits driver-bento" aria-labelledby="driver-detail-benefits-title">
      <div class="wrap">
        <header class="about-centered-heading" data-reveal><p class="eyebrow dark">Herramientas para cada jornada</p><h2 id="driver-detail-benefits-title">Lo que tienes a la vista</h2><p>Funciones para organizarte desde que te conectas hasta que completas un viaje.</p></header>
        <ol class="driver-benefits detail-driver-benefits">{driverBenefits.map((benefit, index) => <li data-reveal><span class="driver-benefit-step">{String(index + 1).padStart(2, '0')}</span><b>{benefit.title}</b><span>{benefit.description}</span></li>)}</ol>
      </div>
    </section>
    <section class="detail-section driver-onboarding" aria-labelledby="driver-onboarding-title">
      <div class="wrap">
        <header class="about-centered-heading" data-reveal><p class="eyebrow dark">Primeros pasos</p><h2 id="driver-onboarding-title">Cómo empezar a conducir con Woki</h2><p>El registro y la revisión se realizan desde la aplicación.</p></header>
        <div class="detail-cards driver-step-strip" tabindex="0" role="region" aria-label="Primeros pasos para conducir con Woki">
          <article data-reveal><span>01</span><h3>Elige el perfil conductor</h3><p>En la app, selecciona la opción para registrarte como conductor.</p></article>
          <article data-reveal><span>02</span><h3>Envía tus documentos</h3><p>Completa tu registro y carga la información solicitada para la revisión.</p></article>
          <article data-reveal><span>03</span><h3>Espera la validación</h3><p>El equipo revisa tus documentos y te activa para que puedas conectarte.</p></article>
        </div>
      </div>
    </section>
    <section class="detail-section driver-detail-reasons" aria-labelledby="driver-detail-reasons-title">
      <div class="wrap">
        <header class="about-centered-heading" data-reveal><p class="eyebrow dark">Woki en Cerro de Pasco</p><h2 id="driver-detail-reasons-title">Una propuesta conectada con la ciudad</h2><p>Woki organiza sus funciones alrededor del servicio de taxi urbano y de la relación entre conductores y pasajeros locales.</p></header>
        <div class="driver-reasons-grid">{driverReasons.map((reason) => <article class="driver-reason" data-reveal><span class="driver-reason-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={reason.iconPath} /></svg></span><h3>{reason.title}</h3><p>{reason.description}</p></article>)}</div>
      </div>
    </section>
    <section class="detail-section" aria-labelledby="driver-workflow-title">
      <div class="wrap detail-two-col">
        <div><p class="eyebrow dark">Una solicitud a la vez</p><h2 id="driver-workflow-title">Revisa los datos y decide con claridad</h2><p>Al conectarte como conductor, la app muestra solicitudes disponibles cerca. Antes de aceptar, revisa la recogida, el destino, la distancia, el tiempo y la forma de pago. La tarifa se presenta para que puedas aceptarla o ajustar tu propuesta según las opciones de la aplicación.</p><p>Esta información sirve para evaluar cada recorrido desde el inicio.</p></div>
        <div><h3>Registro y revisión del perfil</h3><p>Para empezar, elige el perfil de conductor, completa los datos que solicita la app y carga tus documentos para la revisión. El equipo revisa la información y te activa para que puedas conectarte.</p><p>Conoce <a href="/como-funciona">las etapas de un viaje para pasajero y conductor</a> y las <a href="/seguridad">herramientas de seguridad que acompañan cada recorrido</a>. Para consultas sobre el registro, visita <a href="/contacto">Contáctanos</a>.</p></div>
      </div>
    </section>
  </main>
  <Footer />
  <script>import '../scripts/main.ts';</script>
</Layout>

<style>
  .driver-split{position:relative;isolation:isolate;overflow:hidden;background:linear-gradient(115deg,#fff 0%,var(--paper) 100%)}
  .driver-split::before{content:"";position:absolute;z-index:-1;inset:8% 0 auto 53%;height:82%;border-radius:45% 0 0 45%;background:linear-gradient(135deg,color-mix(in srgb,var(--aqua) 17%,white),transparent 72%)}
  .driver-split .detail-driver-grid{grid-template-columns:minmax(0,1.08fr) minmax(0,.92fr);gap:clamp(2rem,6vw,6rem)}
  .driver-split .detail-driver-photo{position:relative;aspect-ratio:1.12;border-radius:clamp(24px,4vw,48px) 12px clamp(24px,4vw,48px) 12px;box-shadow:0 28px 70px color-mix(in srgb,var(--deep) 18%,transparent)}
  .driver-split .detail-driver-photo::after{content:"";position:absolute;inset:12px;border:1px solid rgba(255,255,255,.55);border-radius:inherit;pointer-events:none}
  .driver-split .detail-driver-grid>div:last-child{max-width:510px}
  .driver-split .detail-driver-grid h2{max-width:12ch}
  .driver-split .detail-driver-grid .btn{min-height:48px}
  .driver-bento{background:linear-gradient(180deg,var(--paper),white)}
  .driver-bento .detail-driver-benefits{grid-template-columns:repeat(3,minmax(0,1fr));grid-template-areas:"first second second" "first third fourth";grid-template-rows:repeat(2,minmax(190px,1fr));gap:1rem}
  .driver-bento .detail-driver-benefits li{position:relative;justify-content:space-between;min-height:0;padding:clamp(1.1rem,2vw,1.7rem);border:1px solid color-mix(in srgb,var(--cian) 22%,white);border-top:3px solid var(--cian);border-radius:var(--r-lg);background:#fff;box-shadow:0 15px 36px color-mix(in srgb,var(--deep) 8%,transparent)}
  .driver-bento .detail-driver-benefits li:nth-child(1){grid-area:first;background:linear-gradient(145deg,var(--deep),color-mix(in srgb,var(--deep) 83%,var(--cian)));color:white}
  .driver-bento .detail-driver-benefits li:nth-child(2){grid-area:second}
  .driver-bento .detail-driver-benefits li:nth-child(3){grid-area:third}
  .driver-bento .detail-driver-benefits li:nth-child(4){grid-area:fourth}
  .driver-bento .detail-driver-benefits li b{font-size:clamp(1rem,1.45vw,1.25rem);line-height:1.3}
  .driver-bento .detail-driver-benefits li:nth-child(1) b,.driver-bento .detail-driver-benefits li:nth-child(1)>span:last-child{color:white}
  .driver-bento .detail-driver-benefits li:nth-child(1) .driver-benefit-step{background:var(--pin);color:var(--ink)}
  .driver-bento .detail-driver-benefits li>span:last-child{font-size:.9rem;line-height:1.55}
  .driver-bento .detail-driver-benefits li:hover{transform:translateY(-4px);box-shadow:0 22px 42px color-mix(in srgb,var(--deep) 14%,transparent)}
  .driver-onboarding{overflow:hidden;background:#fff}
  .driver-step-strip{display:grid;grid-template-columns:repeat(3,minmax(250px,1fr));gap:1rem;overflow-x:auto;padding:0 0 1.15rem;scroll-snap-type:x mandatory;scroll-padding:1rem;overscroll-behavior-inline:contain}
  .driver-step-strip article{scroll-snap-align:start;min-height:230px;border-top:3px solid var(--cian);transition:transform .2s ease,box-shadow .2s ease}
  .driver-step-strip article:hover{transform:translateY(-4px);box-shadow:0 22px 42px color-mix(in srgb,var(--deep) 13%,transparent)}
  .driver-step-strip:focus-visible{outline:3px solid var(--pin);outline-offset:5px;border-radius:var(--r-md)}
  @media(max-width:900px){.driver-split .detail-driver-grid{grid-template-columns:1fr;gap:2rem}.driver-split .detail-driver-photo{aspect-ratio:16/10}.driver-split .detail-driver-grid>div:last-child{max-width:680px}.driver-bento .detail-driver-benefits{grid-template-columns:repeat(2,minmax(0,1fr));grid-template-areas:"first second" "first third" "fourth fourth";grid-template-rows:repeat(2,minmax(180px,auto)) minmax(150px,auto)}.driver-bento .detail-driver-benefits li:nth-child(1){grid-row:span 2}.driver-step-strip{grid-template-columns:repeat(3,minmax(260px,1fr))}}
  @media(max-width:600px){.driver-split::before{inset:28% -20% auto 20%;height:48%;border-radius:50%}.driver-split .detail-driver-photo{aspect-ratio:4/3}.driver-bento .detail-driver-benefits{grid-template-columns:1fr;grid-template-areas:"first" "second" "third" "fourth";grid-template-rows:auto}.driver-bento .detail-driver-benefits li:nth-child(1){grid-row:auto;min-height:190px}.driver-step-strip{grid-template-columns:repeat(3,minmax(82vw,1fr));gap:.75rem}.driver-step-strip article{min-height:205px}}
  @media(prefers-reduced-motion:reduce){.driver-bento .detail-driver-benefits li,.driver-step-strip article{transition:none}}
</style>
