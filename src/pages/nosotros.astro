---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { companyPillars, companyPurpose, values } from '../data/content';
import { brand } from '../data/site';
---
<Layout title={`Nosotros | ${brand.name}`} description={`Conoce ${brand.name}, la plataforma local que acerca a pasajeros y conductores de taxi urbano en ${brand.city}.`}>
  <Header solid />
  <main>
    <section class="subpage-hero about-hero"><div class="wrap"><p class="eyebrow">Quiénes somos</p><h1>La ciudad se mueve mejor cuando nos acercamos.</h1><p class="lead">{brand.name} conecta pasajeros y conductores de taxi urbano en {brand.city} con una experiencia sencilla, cercana y pensada para la vida local.</p></div></section>
    <section class="about"><div class="wrap about-grid"><div><p class="eyebrow dark">Nuestra idea</p><h2>Tecnología útil, hecha para moverse por aquí</h2><p class="lead">Creemos que pedir un taxi puede ser claro desde el primer toque: saber quién viene, compartir los datos del viaje y llegar con más tranquilidad. Por eso construimos {brand.name} para conectar a la comunidad con herramientas digitales prácticas.</p><p class="about-note">{brand.legalName} · {brand.city}, {brand.country}</p></div><ul class="values">{values.map((value) => <li><span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={value.iconPath} /></svg></span><h3>{value.title}</h3><p>{value.description}</p></li>)}</ul></div></section>
    <section class="about-who" aria-labelledby="about-who-title">
      <div class="wrap">
        <header class="about-centered-heading" data-reveal>
          <p class="eyebrow dark">Nuestra esencia</p>
          <h2 id="about-who-title">¿Quiénes somos?</h2>
          <p>{companyPurpose.introduction}</p>
        </header>
        <div class="about-mission-grid">
          <article class="about-mission-card" data-reveal>
            <h3 class="about-mission-label">Misión</h3>
            <p>{companyPurpose.mission}</p>
          </article>
          <article class="about-mission-card" data-reveal>
            <h3 class="about-mission-label">Visión</h3>
            <p>{companyPurpose.vision}</p>
          </article>
        </div>
      </div>
    </section>
    <section class="about-location" aria-labelledby="about-location-title">
      <div class="wrap about-location-grid">
        <div class="about-location-copy" data-reveal>
          <p class="eyebrow">Nuestra zona</p>
          <h2 id="about-location-title">¿Dónde operamos?</h2>
          <p>Woki comienza en Cerro de Pasco, conectando a la comunidad con una nueva forma de pedir y coordinar sus viajes urbanos.</p>
          <span class="about-location-tag"><i aria-hidden="true"></i>Cerro de Pasco · Pasco, Perú</span>
        </div>
        <div class="peru-map-wrap" data-reveal>
          <svg class="peru-map" viewBox="80 0 280 360" role="img" aria-labelledby="peru-map-title peru-map-description">
            <title id="peru-map-title">Silueta de Perú con el contorno de Pasco resaltado</title>
            <desc id="peru-map-description">El departamento de Pasco aparece delineado en amarillo dentro de la silueta del Perú.</desc>
            <path d="M316.9 96.3 L299.9 95.5 297.4 98.1 281.9 101.4 260.4 113 259 121 254.2 126.9 256.1 136.1 244.7 141 244.8 148.2 239.8 151.4 247.6 166.7 258.1 177.1 254.1 184.4 266.6 185.4 273.7 194.5 290.3 195 305.8 184.9 304.5 210.8 313.1 212.8 323.7 209.8 340 237.3 336 243.1 335 255.1 334.7 269.6 327.3 278.1 330.7 284.4 326.4 290.2 334.5 304.5 322.6 322.9 317.5 331.6 307.8 336 289 326.2 287.3 319.2 250 302.1 216.2 283.4 201.7 272.9 193.9 258.8 197 253.9 181.1 231.5 162.5 200 144.7 166.1 137 158.3 131.1 145.7 116.4 134.6 103 127.7 109.1 120.1 100 103.8 105.9 91.9 120.9 81.1 123.1 88.2 117.7 92.3 118.2 98.5 126 97.2 133.6 99 141.5 107.6 152.2 100.6 155.7 89.1 167.3 74.2 189.9 67.5 210.5 49.7 216.3 38.6 213.7 25.6 218.7 24 231.2 32.1 237.2 40.1 246 44.5 257 62.4 271.1 64.5 281.4 60 288.2 63 299.5 61.5 314 69.5 301.8 86.9 307.4 87.3 316.9 96.3Z" fill="#6acbd0" fill-opacity=".8" stroke="#c8f5f4" stroke-width="2.5" stroke-linejoin="round" />
            <path d="M174 213.4 174.6 210.4 178.1 208.8 179.4 206.3 183.6 206.8 186.1 205.1 188.6 205 190.9 203.8 192.8 204.3 193.8 202.2 195.4 202.2 196 198.4 197.3 194.3 198.5 190 199.6 190.7 200.7 196.2 203.9 195.8 205.8 196.7 207 200.1 209.3 200.4 211.3 197.2 211.4 202.2 212.9 205.3 215 205 216.2 203.1 216.7 207.1 218.6 206.7 219.9 208.6 222 209.5 223.8 211.2 226.2 210.9 228.5 215.2 227.9 217.8 226.1 220.2 224.1 220.5 222 219.3 220.2 220.3 217.6 221.5 214.8 220.5 212.7 222.1 210.5 222.4 207.8 221.4 205.5 220.1 202.8 220.5 200.9 219.7 198.7 220.3 196.6 220.8 194.2 220.6 193.6 218.5 191.1 218.1 188.8 218.3 186.2 217.9 184 216.9 181.7 216.3 179.4 216.9 177.1 216.4 175.2 215.4Z" fill="none" stroke="#f5a524" stroke-width="2.5" stroke-linejoin="round" />
          </svg>
        </div>
      </div>
    </section>
    <section class="about-how" aria-labelledby="about-how-title">
      <div class="wrap">
        <header class="about-centered-heading" data-reveal>
          <p class="eyebrow dark">Nuestro compromiso</p>
          <h2 id="about-how-title">¿Cómo trabajamos?</h2>
          <p>Cuatro principios orientan la forma en que conectamos cada viaje.</p>
        </header>
        <ul class="about-pillars">
          {companyPillars.map((pillar) => <li data-reveal>
            <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={pillar.iconPath} /></svg></span>
            <h3>{pillar.title}</h3>
            <p>{pillar.description}</p>
          </li>)}
        </ul>
      </div>
    </section>
  </main>
  <Footer />
  <script>import '../scripts/main.ts';</script>
</Layout>
