---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Cta from '../components/Cta.astro';
import Footer from '../components/Footer.astro';
import StoreButtons from '../components/StoreButtons.astro';
import Features from '../components/Features.astro';
import JourneyPanel from '../components/JourneyPanel.astro';
import { benefits, passengerSteps, driverSteps, driverBenefits, driverReasons, faqs, buildJsonLd } from '../data/content';
import { assets, brand } from '../data/site';

const jsonLd = buildJsonLd(Astro.site);
---
<Layout splash>
  {jsonLd.map((j) => <script is:inline type="application/ld+json" set:html={JSON.stringify(j)} slot="head" />)}

  <Header />

  <main>
    <section class="hero" id="inicio">
      <div class="streets" aria-hidden="true"></div>
      <div class="wrap">
        <div class="hero-copy">
          <h1>Muévete fácil y seguro con Woki</h1>
          <p class="lead">Solicita tu taxi en segundos, viaja con conductores verificados y llega a tu destino con confianza en {brand.city}.</p>
          <div class="stores"><StoreButtons /></div>
        </div>
        <div class="phone-wrap" aria-hidden="true">
          <span class="chip c1">✓ Conductor verificado</span><span class="chip c2">Llega en 1 min</span>
          <div class="phone">
            <div class="map"><svg viewBox="0 0 272 210" width="100%" height="100%" preserveAspectRatio="xMidYMid slice"><path d="M44 190V130H200V70" fill="none" stroke="#218e97" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/><circle class="ring" cx="200" cy="64" r="9"/><circle cx="200" cy="64" r="9" fill="#f5a524" stroke="#fff" stroke-width="3"/><circle r="8" fill="#fff" stroke="#218e97" stroke-width="4"><animateMotion dur="6s" repeatCount="indefinite" path="M44 190V130H200V72"/></circle></svg></div>
            <div class="sheet">
              <span class="tag">En camino</span> <small>Llega en 1 min</small>
              <div class="drv"><span class="av">CM</span><div><b>Carlos M.</b> ★ 4.9<br><small>Toyota Yaris · PAS-482</small></div></div>
              <div class="pin"><small>Dale este PIN al conductor</small><b>{brand.demoPin}</b></div>
            </div>
          </div>
        </div>
      </div>
      <svg class="wave" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true"><path d="M0 30C240 70 480 0 720 25s480 40 720 5V60H0z"/></svg>
    </section>

    <div class="how-scroll-track" id="como-funciona" data-scroll-journey>
      <section class="how" aria-labelledby="h-how">
       <div class="wrap tabs">
        <h2 id="h-how" data-reveal>Cómo funciona Woki</h2>
        <p class="lead" data-reveal style="--i:1">Pide tu viaje o recibe solicitudes en pocos pasos.</p>
        <input type="radio" name="rol" id="t-pas" checked />
        <input type="radio" name="rol" id="t-con" />
        <div class="tablist">
          <label for="t-pas"><svg class="role-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="7" r="3.2"/><path d="M5.5 20v-1.8a6.5 6.5 0 0113 0V20z"/></svg><span>Pasajero</span></label>
          <label for="t-con"><svg class="role-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 15l1.5-5h13L20 15v4h-2v-2H6v2H4zM6 10l1.3-3h9.4l1.3 3"/><circle cx="7.5" cy="13" r=".8"/><circle cx="16.5" cy="13" r=".8"/></svg><span>Conductor</span></label>
        </div>
        <JourneyPanel role="pasajero" steps={passengerSteps} />
        <JourneyPanel role="conductor" steps={driverSteps} />
       </div>
      </section>
    </div>

    <section class="benefits" id="seguridad" aria-labelledby="h-ben">
      <div class="wrap">
        <h2 id="h-ben" data-reveal>Tu taxi urbano, más cerca</h2>
        <p class="lead" data-reveal style="--i:1">Woki conecta pasajeros y conductores con confianza, cercanía y facilidad de uso.</p>
        <div class="grid4">
          {benefits.map((benefit) => (
            <article data-reveal class="benefit">
              <span class="sign"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={benefit.iconPath} pathLength="1" /></svg></span>
              <h3>{benefit.title}</h3>
              <p>{benefit.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <Features />

    <section class="drivers" id="conductores" aria-labelledby="h-drv">
      <div class="wrap">
        <div data-reveal class="photo" role="img" aria-label="Conductor Woki sonriendo dentro de su taxi" style={`--driver-photo: url('${assets.driverPhoto}')`}>
          <div class="roof" aria-hidden="true">Woki<small>TAXI</small></div>
          <div class="meter" aria-hidden="true"><small>Ganado hoy</small><b>S/ <span data-count="42" data-dec="2">42.00</span></b></div>
        </div>
        <div>
          <p class="eyebrow dark" data-reveal>Tu trabajo, a tu manera</p>
          <h2 id="h-drv" data-reveal>Maneja con Woki y gana más</h2>
          <p class="lead" data-reveal>Elige tus viajes, conoce la tarifa antes de aceptar y lleva el control de tus ganancias desde la app.</p>
          <p class="driver-benefits-label" data-reveal>Más control en cada recorrido</p>
          <ol class="driver-benefits" data-reveal style="--i:1">
            {driverBenefits.map((benefit, index) => <li><span class="driver-benefit-step" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><b>{benefit.title}</b><span>{benefit.description}</span></li>)}
          </ol>
        </div>
      <div class="driver-reasons" id="beneficios-conductores" aria-labelledby="h-driver-reasons">
        <header class="driver-reasons-head" data-reveal>
          <p class="eyebrow">PARA CONDUCTORES WOKI</p>
          <h2 id="h-driver-reasons">¿Por qué elegir Woki para conducir?</h2>
          <p>Una plataforma cercana a la movilidad de {brand.city}, creada para conectar conductores y pasajeros de la ciudad.</p>
        </header>
        <div class="driver-reasons-grid">
          {driverReasons.map((reason, index) => (
            <article class="driver-reason" data-reveal style={`--i:${index}`}>
              <div class="driver-reason-top"><span class="driver-reason-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={reason.iconPath} /></svg></span></div>
              <h3>{reason.title}</h3>
              <p>{reason.description}</p>
            </article>
          ))}
        </div>
      </div>
      </div>
    </section>

    <section class="faq" id="ayuda" aria-labelledby="h-faq">
      <div class="wrap">
        <div class="faqhead" data-reveal><h2 id="h-faq">Preguntas frecuentes</h2><div class="traffic" aria-hidden="true"><i></i><i></i><i></i></div></div>
        {faqs.map(({ question, answer }) => <details data-reveal><summary>{question}</summary><p>{answer}</p></details>)}
      </div>
    </section>

    <Cta />
  </main>

  <Footer />

  <script>import '../scripts/main.ts';</script>
</Layout>
