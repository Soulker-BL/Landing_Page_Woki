---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Contact from '../components/Contact.astro';
import { brand } from '../data/site';
---
<Layout title={`Contáctanos | ${brand.name}`} description={`Escríbenos para consultas sobre ${brand.name}, el servicio de taxi urbano en ${brand.city}.`}>
  <Header solid />
  <main>
    <section class="subpage-hero contact-hero"><div class="wrap"><p class="eyebrow">Contáctanos</p><h1>¿Tienes algo en mente? Hablemos.</h1><p class="lead">Estamos aquí para orientarte sobre tus viajes, el registro de conductores o cualquier consulta relacionada con Woki.</p></div></section>
    <Contact />
  </main>
  <Footer />
  <script>import '../scripts/main.ts';</script>
</Layout>
