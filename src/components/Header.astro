---
import Logo from './Logo.astro';
import { navigation, routes } from '../data/site';
interface Props { solid?: boolean }
const { solid = false } = Astro.props;
---
<header class:list={['top', { scrolled: solid }]} data-solid={solid ? '' : undefined}>
  <div class="bar">
    <a href={routes.home} aria-label="Woki, inicio"><Logo /></a>
    <nav id="menu" aria-label="Navegación principal">
      {navigation.map((item) => item.children ? (
        <div class="nav-dropdown" data-nav-dropdown>
          <button class="nav-dropdown-trigger" type="button" aria-expanded="false" aria-controls="how-menu" data-nav-trigger>
            {item.label}<svg viewBox="0 0 16 16" aria-hidden="true"><path d="m3 6 5 5 5-5"/></svg>
          </button>
          <div class="nav-submenu" id="how-menu" data-nav-submenu>
            {item.children.map(({ href, label }) => <a href={href} aria-current={Astro.url.pathname !== '/' && Astro.url.pathname === href ? 'page' : undefined}>{label}</a>)}
          </div>
        </div>
      ) : <a href={item.href} aria-current={Astro.url.pathname !== '/' && Astro.url.pathname === item.href ? 'page' : undefined}>{item.label}</a>)}
    </nav>
    <a class="pide" href={routes.download}>
      Viaja ya
      <span class="arr" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M3 8h9M8.5 4l4 4-4 4"/></svg></span>
    </a>
    <button class="burger" aria-label="Abrir menú" aria-expanded="false" aria-controls="menu"><span></span><span></span><span></span></button>
  </div>
</header>
{!solid && <div class="scroll-progress" aria-hidden="true"><span></span></div>}
