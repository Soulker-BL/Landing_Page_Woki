---
interface Props { playUrl?: string }
const { playUrl = import.meta.env.PUBLIC_GOOGLE_PLAY_URL } = Astro.props;
---
{playUrl ? <a class="store" href={playUrl} target="_blank" rel="noopener noreferrer" aria-label="Disponible en Google Play">
  <svg class="store-ic" viewBox="0 0 512 512" aria-hidden="true">
    <path fill="#00c3ff" d="M70 36 296 256 70 476z"/>
    <path fill="#00f076" d="M70 36 380 206 330 256 296 256z"/>
    <path fill="#ff3a44" d="M70 476 380 306 330 256 296 256z"/>
    <path fill="#ffd500" d="M380 206 470 256 380 306 330 256z"/>
  </svg>
  <span><small>DISPONIBLE EN</small><b>Google Play</b></span>
</a> : <span class="store store-pending" aria-label="Google Play">
  <svg class="store-ic" viewBox="0 0 512 512" aria-hidden="true"><path fill="#00c3ff" d="M70 36 296 256 70 476z"/><path fill="#00f076" d="M70 36 380 206 330 256 296 256z"/><path fill="#ff3a44" d="M70 476 380 306 330 256 296 256z"/><path fill="#ffd500" d="M380 206 470 256 380 306 330 256z"/></svg><span><small>DISPONIBLE EN</small><b>Google Play</b></span>
</span>}
