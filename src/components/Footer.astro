---
import Logo from './Logo.astro';
import StoreButtons from './StoreButtons.astro';
import { casas, contacto } from '../data/content';
---
<footer>
    <div class="sky" aria-hidden="true">
      <span class="cloud"></span><span class="cloud b"></span>
      <svg viewBox="0 0 1440 140" preserveAspectRatio="xMidYMax slice">
        <path d="M0 140V70l120-30 110 24 130-42 140 44 140-28 120 32 140-40 140 34 140-38 140 34 120-16v96z" fill="#9fdfe2" opacity=".55"/>
        <path d="M0 140V92l100-26 90 20 100-50 110 52 100-16 120 22 140-14 120 12 130-30 130-34 130 56 80-18 100 24v62z" fill="#3b9ba4"/>
        <path d="M290 36l51 24-19-4-12 12-14-11-14 13-14-12-23 0z" fill="#e9f7f8"/>
        <path d="M1130 28l65 28-23-4-14 16-16-14-18 16-16-17-70-1z" fill="#e9f7f8"/>
        {casas.map((c) => <g><rect x={c.x} y={c.top} width={c.w} height={110 - c.top} fill={c.c} /><path d={`M${c.x - 2} ${c.top}L${c.x + c.w / 2} ${c.top - 7}L${c.x + c.w + 2} ${c.top}z`} fill="#00434c" /></g>)}
        <path d="M0 140V92c120-8 200 0 280 8 120 6 280 2 420 2h40c140 0 300 4 420-2 80-8 160-16 280-8v48z" fill="#005b66"/>
        <g fill="#005b66">
          <rect x="668" y="52" width="20" height="56"/><rect x="752" y="52" width="20" height="56"/>
          <path d="M666 52h24L678 34zM750 52h24L762 34zM688 108V80l32-16 32 16v28z"/>
          <path d="M678 34v-9M674 29h8M762 34v-9M758 29h8" stroke="#005b66" stroke-width="2" fill="none"/>
        </g>
        <rect class="lit" x="674" y="62" width="8" height="14" rx="4"/><rect class="lit" x="758" y="62" width="8" height="14" rx="4"/>
        <circle class="lit" cx="720" cy="80" r="5"/>
        <path class="lit" d="M712 108V96a8 8 0 0116 0v12z"/>
      </svg>
    </div>
    <div class="wrap foot">
      <div data-reveal>
        <Logo light />
        <p class="tag-line">Tu taxi urbano, más cerca, seguro y confiable.</p>
      </div>
      <nav aria-label="Pie de página" data-reveal style="--i:1"><h3>Woki</h3><ul><li><a href="/#como-funciona">Cómo funciona</a></li><li><a href="/#seguridad">Seguridad</a></li><li><a href="/#conductores">Conductores</a></li><li><a href="/nosotros">Nosotros</a></li><li><a href="/contacto">Contáctanos</a></li><li><a href="/eliminar-cuenta">Eliminar cuenta</a></li></ul></nav>
      <div data-reveal style="--i:2"><h3>Contacto</h3><ul><li><a href={`mailto:${contacto.email}`}>{contacto.email}</a></li><li>Cerro de Pasco, Perú</li></ul></div>
      <div data-reveal style="--i:3"><h3>Descarga la app</h3><div class="mini"><StoreButtons /></div></div>
    </div>
    <div class="checker foot-checker" aria-hidden="true"></div>
    <div class="wrap legal">
      <span>© {new Date().getFullYear()} Woki Mobility S.A.C. Todos los derechos reservados.</span>
      <span><a href="/terminos">Términos</a> · <a href="/privacidad">Privacidad</a> · <a href="/eliminar-cuenta">Eliminar cuenta</a></span>
      <a class="up" href="#inicio">Volver arriba <svg viewBox="0 0 16 16"><path d="M3 10l5-5 5 5"/></svg></a>
    </div>
    <div class="mark" aria-hidden="true">Woki</div>
  </footer>
