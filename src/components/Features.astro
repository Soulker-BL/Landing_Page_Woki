---
import { features, edificios, ventanas } from '../data/content';
import { brand } from '../data/site';
const [featured, ...remainingFeatures] = features;
---
<section class="features" aria-labelledby="h-feat">
  <svg class="skyline" viewBox="0 0 800 660" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <linearGradient id="city-horizon" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#218e97" stop-opacity="0"/><stop offset="1" stop-color="#218e97" stop-opacity=".25"/></linearGradient>
      <radialGradient id="moon-glow"><stop stop-color="#f5d27a" stop-opacity=".2"/><stop offset="1" stop-color="#f5d27a" stop-opacity="0"/></radialGradient>
      <radialGradient id="town-glow"><stop stop-color="#f5a524" stop-opacity=".18"/><stop offset="1" stop-color="#f5a524" stop-opacity="0"/></radialGradient>
    </defs>
    <rect class="skyline-horizon" x="0" y="0" width="800" height="660" />
    <circle class="moon-glow" cx="680" cy="85" r="105" />
    <g class="moon-pulse" transform="translate(680 85) scale(1.35) translate(-680 -85)"><path class="moon" d="M681 67a17 17 0 1017 23 14 14 0 01-17-23z" /></g>
    <g class="skyline-stars">
      <circle cx="95" cy="43" r="1.5"/><circle cx="188" cy="102" r="1"/><circle cx="309" cy="38" r="1.4"/><circle cx="425" cy="74" r="1"/><circle cx="553" cy="34" r="1.3"/><circle cx="756" cy="119" r="1.5"/>
    </g>
    <ellipse class="town-glow" cx="410" cy="620" rx="390" ry="150" />
    <path class="mountain-back" d="M0 520l76-55 68 25 102-128 90 116 75-57 76 50 92-119 92 105 72-42 57 35v210H0z" />
    <path class="mountain-front" d="M0 570l96-54 82 38 83-73 93 77 88-44 90 53 104-77 83 60 81-41v151H0z" />
    <path class="mountain-ridge" d="M144 490l102-128 90 116m167-7l92-119 92 105m-589 57l83-73 93 77m175-24l104-77 83 60" />
    {edificios.map(([x, w, h]) => (
      <g class="skyline-building">
        <rect class="b" x={x} y={660 - h * 1.4} width={w} height={h * 1.4} />
        <path class="roofline" d={`M${x} ${660 - h * 1.4}l${w / 2} -10 ${w / 2} 10`} />
      </g>
    ))}
    {ventanas.map((v) => <rect class="w" x={v.x} y={v.y} width="5" height="7" style={`animation-delay:${v.d}s`} />)}
  </svg>
  <div class="wrap">
    <div class="head" data-reveal>
      <div>
        <p class="eyebrow">Funciones</p>
        <h2 id="h-feat">Todo lo que necesitas para <em>viajar tranquilo</em></h2>
      </div>
      <p class="head-lead">Funciones pensadas para que pedir un taxi sea simple y seguro, desde que lo pides hasta que llegas.</p>
    </div>
    <div class="cards">
      <article data-reveal class="card big">
        <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={featured.iconPath} /></svg></span>
        <h3>{featured.title}</h3>
        <p>{featured.description}</p>
        <div class="pin" aria-hidden="true"><small>Tu PIN de viaje</small><b data-slot={brand.demoPin}>{brand.demoPin}</b></div>
      </article>
      {remainingFeatures.map((feature) => (
        <article data-reveal class="card">
          <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={feature.iconPath} /></svg></span>
          <h3>{feature.title}</h3>
          <p>{feature.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
