---
import { contacto } from '../data/content';
const contactFormEndpoint = import.meta.env.PUBLIC_CONTACT_FORM_ENDPOINT;
---
<section class="contact" id="contacto" aria-labelledby="h-contact">
  <div class="wrap contact-grid">
    <div data-reveal>
      <p class="eyebrow dark">Contacto</p>
      <h2 id="h-contact">Hablemos, estamos para ayudarte</h2>
      <p class="lead">¿Tienes una duda, una sugerencia o quieres manejar con Woki? Escríbenos y te respondemos lo antes posible.</p>
      <div class="contact-list">
        <a href={`mailto:${contacto.email}`}><span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 6h18v12H3zM3 7l9 6 9-6" /></svg></span><span><b>Correo</b><span>{contacto.email}</span></span></a>
        <div><span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 21s-7-6-7-11a7 7 0 0114 0c0 5-7 11-7 11zM12 10m-2.5 0a2.5 2.5 0 105 0 2.5 2.5 0 10-5 0" /></svg></span><span><b>Ubicación</b><span>{contacto.ubicacion}</span></span></div>
        <div><span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M20.2 11.6a8.2 8.2 0 01-12.1 7.2L3 20l1.2-5a8.2 8.2 0 1116-3.4z" /><path d="M8.2 7.8c-.5.4-.8 1-.7 1.7.2 1.1 1 2.6 2.3 3.9 1.3 1.3 2.8 2.1 3.9 2.3.7.1 1.3-.2 1.7-.7l.5-.7-2.2-1.2-1 1c-.7-.3-1.4-.8-2-1.4-.6-.6-1.1-1.3-1.4-2l1-1-1.2-2.2-.9.3z" /></svg></span><span><b>WhatsApp</b><span>{contacto.whatsapp}{contacto.whatsappIsTemporary && ' · número temporal'}</span></span></div>
      </div>
    </div>
    <form class="form contact-form" data-contact-form data-endpoint={contactFormEndpoint ?? ''} data-email={contacto.email} data-reveal>
      <h2>Cuéntanos en qué podemos ayudarte</h2>
      <p class="form-intro">Usaremos tus datos para responder esta consulta. Revisa nuestra <a href="/privacidad">política de privacidad</a>.</p>
      <label>Nombre<input name="nombre" type="text" autocomplete="name" placeholder="Tu nombre" required /></label>
      <label>Correo o teléfono<input name="contacto" type="text" autocomplete="email" placeholder="¿Cómo te contactamos?" required /></label>
      <label>¿Sobre qué nos escribes?
        <select name="motivo" required>
          <option value="" selected disabled>Elige una opción</option>
          <option>Soy pasajero</option>
          <option>Quiero ser conductor</option>
          <option>Alianzas o prensa</option>
          <option>Otro</option>
        </select>
      </label>
      <label>Mensaje<textarea name="mensaje" placeholder="Escribe aquí tu consulta" required></textarea></label>
      <label class="hp" aria-hidden="true">No completar<input name="website" tabindex="-1" autocomplete="off" /></label>
      <label class="check"><input type="checkbox" name="consentimiento" required /><span>Acepto que Woki use mis datos para responder esta consulta.</span></label>
      <button class="btn solid" type="submit">Enviar mensaje</button>
      <p class="form-status" data-form-status role="status" aria-live="polite"></p>
    </form>
  </div>
</section>
