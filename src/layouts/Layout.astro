---
import '@fontsource-variable/open-sans';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Taxi from '../components/Taxi.astro';
import { assets, brand } from '../data/site';

interface Props { title?: string; description?: string; image?: string; splash?: boolean }
const {
  title = brand.defaultTitle,
  description = brand.defaultDescription,
  image = assets.socialImage,
  splash = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const gtmContainerId = import.meta.env.PUBLIC_GTM_CONTAINER_ID?.trim();
const gtmEnabled = import.meta.env.PUBLIC_GTM_ENABLED === 'true' && /^GTM-[A-Z0-9]+$/.test(gtmContainerId ?? '');
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION?.trim();
---
<!doctype html>
<html lang="es-PE" class:list={{ 'no-splash': !splash }} style={`--about-banner: url('${assets.aboutBanner}'); --contact-banner: url('${assets.contactBanner}')`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={brand.themeColor} />
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`${brand.name} — ${title}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${brand.name} — ${title}`} />
    <slot name="head" />
    {gtmEnabled && <script is:inline define:vars={{ gtmContainerId }}>
      (() => {
        const consentKey = 'woki-analytics-consent';
        const loadGoogleTagManager = () => {
          if (window.wokiGtmLoaded) return;
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
          const script = document.createElement('script');
          script.async = true;
          script.src = `https://www.googletagmanager.com/gtm.js?id=${gtmContainerId}`;
          document.head.appendChild(script);
          window.wokiGtmLoaded = true;
        };
        window.addEventListener('woki:analytics-consent', (event) => {
          if (event.detail === 'granted') {
            try { localStorage.setItem(consentKey, 'granted'); } catch {}
            loadGoogleTagManager();
          } else if (event.detail === 'denied') {
            try { localStorage.setItem(consentKey, 'denied'); } catch {}
          }
        });
        try {
          if (localStorage.getItem(consentKey) === 'granted') loadGoogleTagManager();
        } catch {}
      })();
    </script>}
    <script is:inline>document.documentElement.classList.add('js')</script>
    {splash && <script is:inline>try{if(sessionStorage.getItem('woki-splash')){document.documentElement.classList.add('no-splash')}else{sessionStorage.setItem('woki-splash','1')}}catch(e){}</script>}
  </head>
  <body id="top">
    {splash && (
      <div class="splash" aria-hidden="true">
        <div>
          <Logo light />
          <p class="splash-tag">Tu taxi urbano, <em>más cerca</em></p>
          </div>
        <div class="road" aria-hidden="true"><Taxi /></div>
      </div>
    )}
    <slot />
  </body>
</html>
