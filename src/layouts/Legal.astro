---
import Layout from './Layout.astro';
import { brand } from '../data/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { brand } from '../data/site';
interface Props { title: string; description: string; updated?: string }
const { title, description, updated = brand.legalUpdated } = Astro.props;
---
<Layout title={`${title} | ${brand.name}`} description={description}>
  <Header solid />
  <main class="legal-page wrap">
    <h1>{title}</h1>
    <p class="updated">Última actualización: {updated}</p>
    <slot />
  </main>
  <Footer />
  <script>import '../scripts/main.ts';</script>
</Layout>
